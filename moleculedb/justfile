# List available recipes
default:
    @just --list

# Install backend and frontend dependencies
install:
    cd backend && uv sync
    cd frontend && pnpm install

# Run backend + frontend dev servers together
dev:
    process-compose up --tui=false

test:
    cd backend && uv run pytest

lint:
    cd backend && uv run ruff check . && uv run ruff format --check .
    cd frontend && pnpm lint

build:
    cd frontend && pnpm build

# Download datasets into data/ (skips files already present)
data:
    cd backend && uv run python -c "from moleculedb import esol; esol.download()"

# Build the ESOL mmpdb database (data/esol/esol.mmpdb)
esol: data
    cd backend && uv run python -m moleculedb.esol

# Open JupyterLab in notebooks/
notebook:
    cd backend && uv run jupyter lab ../notebooks

# ESOL benchmark: hand-crafted features vs learned graph model
bench *args:
    cd backend && uv run python -m moleculedb.ml.benchmark {{args}}
